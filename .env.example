APP_NAME="Outlier Vault"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SHOW_COMING_SOON=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vvf_enterprise
DB_USERNAME=postgres
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=vvf_enterprise

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

APIFY_BASE_URL=https://api.apify.com/v2
APIFY_TOKEN=
APIFY_DEFAULT_ACTOR=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Custom keyword search — one phrase in, a saved, refreshing viral video list out.
# The Apify task is called with the phrase only; keywords are applied locally.
CUSTOM_KEYWORD_SEARCH_APIFY_TASK_ID=
CUSTOM_KEYWORD_SEARCH_OPENAI_MODEL=gpt-4.1-mini
CUSTOM_KEYWORD_SEARCH_MAX_RESULTS=100
CUSTOM_KEYWORD_SEARCH_MIN_FOLLOWERS=500
CUSTOM_KEYWORD_SEARCH_SCHEDULE_TIME=19:00
CUSTOM_KEYWORD_SEARCH_SCHEDULE_TIMEZONE=America/New_York
CUSTOM_KEYWORD_SEARCH_QUEUE=default

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_SESSION_KEY=admin.authenticated
ADMIN_ROOT_NAME="Root Admin"
ADMIN_ROOT_EMAIL=admin@example.com
ADMIN_ROOT_PASSWORD=change-me
